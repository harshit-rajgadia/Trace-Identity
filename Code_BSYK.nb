  3.955241807183256*^9, 3.95524180791336*^9}},
 FontSize->16,ExpressionUUID->"5b3e483f-0e76-49ce-88c0-37bfe59beb52"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"M", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Sign", "[", 
       RowBox[{"j", "-", "i"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "1", ",", "n"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"M", "[", "n", "]"}], " ", "defines", " ", "an", " ", "n", " ", 
     "*", " ", "n", " ", "matrix", " ", "with", " ", "entries", " ", 
     RowBox[{"M", "[", 
      RowBox[{"i", ",", "j"}], "]"}]}], " ", "=", " ", 
    RowBox[{"Sgn", "[", 
     RowBox[{"j", "-", "i"}], "]"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Alpha]", "[", 
     RowBox[{"n_", ",", "k_"}], "]"}], ":=", 
    RowBox[{"-", 
     RowBox[{"Tr", "[", 
      RowBox[{"MatrixPower", "[", 
       RowBox[{
        RowBox[{"M", "[", "n", "]"}], ",", 
        RowBox[{"2", " ", "k"}]}], "]"}], "]"}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"\[Alpha]", "[", 
     RowBox[{"n", ",", "k"}], "]"}], " ", "=", " ", 
    RowBox[{"-", 
     RowBox[{"Tr", "[", 
      RowBox[{
       RowBox[{"M", "[", "n", "]"}], "^", 
       RowBox[{"(", 
        RowBox[{"2", "k"}], ")"}]}], "]"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"l", "[", "n_", "]"}], ":=", 
    RowBox[{"Floor", "[", 
     RowBox[{"n", "/", "2"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"l", "[", "n", "]"}], " ", "=", " ", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{"n", "/", "2"}], "\[RightFloor]"}]}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"MatrixIdentity", "[", 
    RowBox[{"n_", ",", "r_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Binomial", "[", 
        RowBox[{"n", ",", 
         RowBox[{
          RowBox[{"2", " ", 
           RowBox[{"l", "[", "n", "]"}]}], "-", 
          RowBox[{"2", " ", "m"}]}]}], "]"}], "*", 
       RowBox[{"\[Alpha]", "[", 
        RowBox[{"n", ",", 
         RowBox[{"m", "-", "r"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"m", ",", 
        RowBox[{"r", "+", "1"}], ",", 
        RowBox[{"l", "[", "n", "]"}]}], "}"}]}], "]"}], "==", 
    RowBox[{"2", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"l", "[", "n", "]"}], "-", "r"}], ")"}], "*", 
