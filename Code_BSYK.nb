Cell[TextData[{
 StyleBox["The function MatrixIdentity takes n and r as inputs and returns \
True iff the following equation is true for 0 \[LessEqual] r \
\[LessEqual]l[n]-1:",
  FontSize->20],
 StyleBox["\n",
  FontSize->18],
 StyleBox["\n",
  FontSize->16],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"m", "=", 
       RowBox[{"r", "+", "1"}]}], 
      RowBox[{"l", "(", "n", ")"}]], 
     RowBox[{
      TemplateBox[{"n", 
        RowBox[{
          RowBox[{"2", " ", 
            RowBox[{"l", "(", "n", ")"}]}], "-", 
          RowBox[{"2", " ", "m"}]}]},
       "Binomial"], " ", 
      RowBox[{"\[Alpha]", "(", 
       RowBox[{"n", ",", 
        RowBox[{"m", "-", "r"}]}], ")"}]}]}], "\[LongEqual]", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"l", "(", "n", ")"}], "-", "r"}], ")"}], " ", 
     TemplateBox[{"n", 
       RowBox[{
         RowBox[{"2", " ", 
           RowBox[{"l", "(", "n", ")"}]}], "-", 
         RowBox[{"2", " ", "r"}]}]},
      "Binomial"]}]}], TraditionalForm]], "Input",
  CellChangeTimes->{3.95524178125854*^9},
  FontSize->18,ExpressionUUID->"2b7fd149-f49e-46d0-a627-74d95841a69d"]
}], "Text",
 CellChangeTimes->{{3.95431125577579*^9, 3.954311288488921*^9}, {
  3.9552417939176893`*^9, 3.955241801448038*^9}, {3.955242002708351*^9, 
  3.9552420165560083`*^9}, {3.9552440140391197`*^9, 3.955244053084553*^9}},
 FontSize->16,ExpressionUUID->"5645dc9b-da1c-49cb-a9ca-9ae19dba479a"],

Cell[TextData[StyleBox["We check the relation for 1000 randomly chosen pairs \
of integers (n,r) in range  n \[LessEqual] 100 and r \[LessEqual] l[n] -1:",
 FontSize->20]], "Text",
 CellChangeTimes->{{3.955242043744947*^9, 3.955242103706244*^9}, {
   3.955242230358625*^9, 3.9552424186008263`*^9}, {3.95524305806567*^9, 
   3.955243063370717*^9}, 3.955243405400701*^9, {3.95524363098103*^9, 
   3.955243633394635*^9}, {3.955243673419011*^9, 3.955243675997468*^9}, {
   3.955243795572681*^9, 3.955243797923266*^9}, 3.9552438327179317`*^9},
 FontSize->16,ExpressionUUID->"31ef225c-ad2b-4f5c-b19b-c751b9661b21"],

Cell[CellGroupData[{

Cell[BoxData[{
 StyleBox[
  RowBox[{
   RowBox[{"Pairs", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", "b"}], "}"}], ",", 
        RowBox[{
         RowBox[{"a", "=", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{"2", ",", "100"}], "}"}], "]"}]}], ";", 
         RowBox[{"b", "=", 
          RowBox[{"RandomInteger", "[", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{
              RowBox[{"l", "[", "a", "]"}], "-", "1"}]}], "}"}], "]"}]}], ";",
          "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"a", ",", "b"}], "}"}]}]}], "]"}], ",", 
      RowBox[{"{", "1000", "}"}]}], "]"}]}], ";"}],
  FontSize->16], "\[IndentingNewLine]", 
 StyleBox[
  RowBox[{"CheckIdentity", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"MatrixIdentity", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Pairs", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Pairs", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "1000"}], "}"}]}], "]"}]}],
  FontSize->16]}], "Input",
 CellChangeTimes->{{3.955243071287127*^9, 3.95524314900661*^9}, {
