Cell[TextData[{
 StyleBox["Verifying the Trace Identity: ",
  FontSize->24],
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"m", "=", 
       RowBox[{"r", "+", "1"}]}], 
      RowBox[{"l", "(", "n", ")"}]], 
     RowBox[{
      TemplateBox[{"n", 
        RowBox[{
          RowBox[{"2", " ", 
            RowBox[{"l", "(", "n", ")"}]}], "-", 
          RowBox[{"2", " ", "m"}]}]},
       "Binomial"], " ", 
      RowBox[{"\[Alpha]", "(", 
       RowBox[{"n", ",", 
        RowBox[{"m", "-", "r"}]}], ")"}]}]}], "\[LongEqual]", 
    RowBox[{"2", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"l", "(", "n", ")"}], "-", "r"}], ")"}], " ", 
     TemplateBox[{"n", 
       RowBox[{
         RowBox[{"2", " ", 
           RowBox[{"l", "(", "n", ")"}]}], "-", 
         RowBox[{"2", " ", "r"}]}]},
      "Binomial"]}]}], TraditionalForm]],
  CellChangeTimes->{3.954310739489279*^9, 3.9543108084241757`*^9},
  FontSize->24,ExpressionUUID->"c7e26d84-2dba-43cb-96e7-ccbf4c77fd80"]
}], "Section",
